# Local development. For a Coolify or docker compose deployment, see the block at the bottom.

NODE_ENV=development

DATABASE_URL=postgres://collaby:collaby@localhost:5432/collaby

HOST=0.0.0.0
PORT=4000

# Where the browser reaches the web app and the API.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SECRET_ENCRYPTION_KEY=change-me-to-another-long-random-string-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Git repositories and uploaded images live here.
DATA_DIR=./data

WEBAUTHN_RP_NAME=Collaby
# Defaults to the hostname of PUBLIC_WEB_URL. Set it explicitly behind a proxy.
# WEBAUTHN_RP_ID=collaby.example.com

# Optional single sign on through any OpenID Connect provider: Auth0, Authentik,
# Keycloak, Zitadel, Logto, Google, and so on.
#
# Register Collaby there as a regular web application and allow this callback URL:
#   PUBLIC_API_URL + /api/auth/oidc/callback
#
# OIDC_ISSUER is the base URL, without /.well-known/openid-configuration.
# OIDC_ISSUER=https://your-tenant.eu.auth0.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# The button reads "Continue with <name>". Defaults to a name taken from the issuer.
# OIDC_PROVIDER_NAME=Auth0

ALLOW_REGISTRATION=true

# How long to wait after the last edit before committing a document to git.
GIT_COMMIT_DEBOUNCE_MS=30000
GIT_AUTHOR_NAME=Collaby
GIT_AUTHOR_EMAIL=bot@collaby.local

MAX_UPLOAD_BYTES=26214400

# In development the web app runs on a different port than the API, so it needs
# the absolute API origin. In production both are served from one domain and
# these stay empty.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4000/collab

# Used by the web server when it renders link previews for shared pages. In compose
# these are set for you; locally the defaults above are enough.
# INTERNAL_API_URL=http://server:4000

# ---------------------------------------------------------------------------
# docker compose / Coolify
#
# The compose file serves the web app and the API from a single domain through
# Caddy, so NEXT_PUBLIC_API_URL and NEXT_PUBLIC_COLLAB_URL stay unset there.
#
# POSTGRES_PASSWORD=
# JWT_SECRET=
# SECRET_ENCRYPTION_KEY=
# PUBLIC_WEB_URL=https://collaby.example.com
# PUBLIC_PORT=8080
